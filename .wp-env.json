{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.2",
	"themes": [ "./wp-content/themes/daguah" ],
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.11.3.0.zip",
		"https://downloads.wordpress.org/plugin/dokan-lite.5.3.4.zip",
		"https://downloads.wordpress.org/plugin/woocommerce-gateway-stripe.11.2.0.zip",
		"https://downloads.wordpress.org/plugin/woo-paystack.5.8.6.zip",
		"https://downloads.wordpress.org/plugin/woocommerce-multilingual.zip",
		"https://downloads.wordpress.org/plugin/seo-by-rank-math.1.0.282.zip",
		"https://downloads.wordpress.org/plugin/wp-mail-smtp.4.10.4.zip",
		"./wp-content/plugins/daguah-core"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local"
	},
	"lifecycleScripts": {
		"afterStart": "npx @wordpress/env run cli wp theme activate daguah && npx @wordpress/env run cli wp daguah seed"
	}
}
