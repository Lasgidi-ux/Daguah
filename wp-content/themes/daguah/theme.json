{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Market at Dusk",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1280px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "night", "name": "Night", "color": "#131209" },
				{ "slug": "night-raised", "name": "Night raised", "color": "#1F1F1F" },
				{ "slug": "night-line", "name": "Night line", "color": "#313131" },
				{ "slug": "lantern", "name": "Lantern", "color": "#D9A21B" },
				{ "slug": "indigo", "name": "Indigo", "color": "#24306B" },
				{ "slug": "laterite", "name": "Laterite", "color": "#B5532A" },
				{ "slug": "palm", "name": "Palm", "color": "#2F5D46" },
				{ "slug": "shea", "name": "Shea", "color": "#F2EADB" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": false,
			"fontStyle": false,
			"lineHeight": false,
			"dropCap": false,
			"textColumns": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, \"Segoe UI\", \"Helvetica Neue\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-vietnamese-wght-normal.woff2" ],
							"unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB"
						}
					]
				},
				{
					"slug": "geist-mono",
					"name": "Geist Mono",
					"fontFamily": "\"Geist Mono\", ui-monospace, \"SF Mono\", Consolas, \"Liberation Mono\", monospace",
					"fontFace": [
						{
							"fontFamily": "Geist Mono",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist-mono-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Geist Mono",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist-mono-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "12 / 16", "size": "0.75rem" },
				{ "slug": "sm", "name": "14 / 20", "size": "0.875rem" },
				{ "slug": "base", "name": "16 / 24", "size": "1rem" },
				{ "slug": "lg", "name": "18 / 28", "size": "1.125rem" },
				{ "slug": "xl", "name": "20 / 28", "size": "1.25rem" },
				{ "slug": "xxl", "name": "24 / 32", "size": "1.5rem" },
				{ "slug": "xxxl", "name": "30 / 36", "size": "1.875rem" },
				{ "slug": "display-sm", "name": "36 / 40", "size": "2.25rem" },
				{ "slug": "display-md", "name": "48 / 48", "size": "3rem" },
				{ "slug": "display-lg", "name": "60 / 60", "size": "3.75rem" },
				{ "slug": "display-xl", "name": "72 / 72", "size": "4.5rem" },
				{ "slug": "display-xxl", "name": "96 / 96", "size": "6rem" },
				{ "slug": "display-max", "name": "128 / 128", "size": "8rem" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "%" ],
			"spacingSizes": [
				{ "slug": "25", "name": "2", "size": "2px" },
				{ "slug": "50", "name": "4", "size": "4px" },
				{ "slug": "75", "name": "8", "size": "8px" },
				{ "slug": "100", "name": "12", "size": "12px" },
				{ "slug": "200", "name": "16", "size": "16px" },
				{ "slug": "300", "name": "24", "size": "24px" },
				{ "slug": "400", "name": "32", "size": "32px" },
				{ "slug": "500", "name": "40", "size": "40px" },
				{ "slug": "600", "name": "48", "size": "48px" },
				{ "slug": "700", "name": "64", "size": "64px" },
				{ "slug": "800", "name": "80", "size": "80px" },
				{ "slug": "900", "name": "96", "size": "96px" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"radiusSizes": [
				{ "slug": "sm", "name": "2", "size": "2px" },
				{ "slug": "base", "name": "4", "size": "4px" },
				{ "slug": "md", "name": "6", "size": "6px" },
				{ "slug": "lg", "name": "8", "size": "8px" },
				{ "slug": "xl", "name": "12", "size": "12px" },
				{ "slug": "xxl", "name": "16", "size": "16px" },
				{ "slug": "xxxl", "name": "24", "size": "24px" },
				{ "slug": "full", "name": "Full", "size": "9999px" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"custom": {
			"color": {
				"base": "#131209",
				"raised": "#1F1F1F",
				"line": "#313131",
				"skeleton": "#272727",
				"text": "#F2EADB",
				"textMuted": "#ABA598",
				"action": "#D9A21B",
				"actionText": "#131209",
				"actionHover": "#F2EADB",
				"actionHoverText": "#131209",
				"link": "#D9A21B",
				"focus": "#D9A21B",
				"secondary": "#24306B",
				"onSecondary": "#F2EADB",
				"tag": "#B5532A",
				"onTag": "#FFFFFF",
				"success": "#2F5D46",
				"onSuccess": "#F2EADB",
				"navSurface": "rgba(31, 31, 31, 0.72)",
				"menuSurface": "rgba(19, 18, 9, 0.92)",
				"heroFrom": "#FFFFFF",
				"heroTo": "#9B9B9B"
			},
			"radius": {
				"sm": "2px",
				"base": "4px",
				"md": "6px",
				"lg": "8px",
				"xl": "12px",
				"xxl": "16px",
				"xxxl": "24px",
				"full": "9999px"
			},
			"motion": {
				"ease": "cubic-bezier(0.22, 1, 0.36, 1)",
				"layout": "500ms",
				"hover": "300ms",
				"reveal": "700ms"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--custom--color--base)",
			"text": "var(--wp--custom--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--300)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--200)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--200)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--custom--color--link)" }
			},
			"heading": {
				"typography": { "fontWeight": "600" },
				"color": { "text": "var(--wp--custom--color--text)" }
			},
			"h1": { "typography": { "fontSize": "var(--daguah-h1)", "lineHeight": "var(--daguah-h1-lh)" } },
			"h2": { "typography": { "fontSize": "var(--daguah-h2)", "lineHeight": "var(--daguah-h2-lh)" } },
			"h3": { "typography": { "fontSize": "var(--daguah-h3)", "lineHeight": "var(--daguah-h3-lh)" } },
			"h4": { "typography": { "fontSize": "var(--daguah-h4)", "lineHeight": "var(--daguah-h4-lh)" } },
			"h5": { "typography": { "fontSize": "var(--daguah-h5)", "lineHeight": "var(--daguah-h5-lh)" } },
			"h6": { "typography": { "fontSize": "var(--daguah-h6)", "lineHeight": "var(--daguah-h6-lh)" } },
			"button": {
				"color": {
					"background": "var(--wp--custom--color--action)",
					"text": "var(--wp--custom--color--action-text)"
				},
				"border": { "radius": "var(--wp--custom--radius--lg)" },
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--75)",
						"right": "var(--wp--preset--spacing--100)",
						"bottom": "var(--wp--preset--spacing--75)",
						"left": "var(--wp--preset--spacing--100)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "600",
					"lineHeight": "1.5",
					"textDecoration": "none"
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--sm)", "lineHeight": "1.4286" },
				"color": { "text": "var(--wp--custom--color--text-muted)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--lg)", "fontWeight": "700", "lineHeight": "1.5556", "letterSpacing": "0.08em" },
				"elements": { "link": { "color": { "text": "var(--wp--custom--color--text)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--sm)", "fontWeight": "500", "lineHeight": "1.4286" },
				"elements": { "link": { "color": { "text": "var(--wp--custom--color--text)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--custom--color--line)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "mobile-menu", "title": "Mobile menu", "area": "uncategorized" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "stall-card", "title": "Stall card", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-system", "title": "System sheet", "postTypes": [ "page" ] },
		{ "name": "page-stalls", "title": "Stall directory", "postTypes": [ "page" ] },
		{ "name": "page-occasions", "title": "Occasions", "postTypes": [ "page" ] },
		{ "name": "page-circle", "title": "DAGUAH Circle", "postTypes": [ "page" ] },
		{ "name": "page-send-home", "title": "Send Home", "postTypes": [ "page" ] },
		{ "name": "page-live", "title": "Market Live schedule", "postTypes": [ "page" ] }
	]
}
